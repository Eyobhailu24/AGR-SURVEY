# Copy the real values for these into .env (not committed). Everything below
# DATABASE_URL/AI_GATEWAY_API_KEY was already provisioned by the Neon/Vercel/v0
# integration; the auth-related ones need to be created by you.

# --- Already provisioned (see your real .env) ---
# DATABASE_URL=
# AI_GATEWAY_API_KEY=

# --- Auth.js (NextAuth v5) ---
# Random secret used to sign session/CSRF tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Authorized redirect URI must be:
#   <your-app-url>/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that are auto-promoted to super_admin on their
# very first sign-in (bootstraps who can approve everyone else).
SUPER_ADMIN_EMAILS=support@smoltrade.com
