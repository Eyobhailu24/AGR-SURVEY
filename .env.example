# Copy the real values for these into .env (not committed). DATABASE_URL was
# provisioned by the Neon/Vercel/v0 integration; the xKiro and auth values
# need to be created by you.

# --- Already provisioned (see your real .env) ---
# DATABASE_URL=

# --- AI assistant (xKiro) ---
# xKiro is an OpenAI-compatible gateway; one key covers the research
# assistant and the handwritten-notebook image extractor. Server-side only
# — never prefix any of these with NEXT_PUBLIC_.
# Model ids are env-driven so an unhealthy free-tier model can be swapped
# without a code change. Check availability with:
#   curl https://api.xkiro.com/v1/models -H "Authorization: Bearer $XKIRO_API_KEY"
# AI_MODEL must support both tools and vision (the image importer shares it).
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
AI_MODEL=mistralai/mistral-large-2512
AI_FALLBACK_MODEL=mistralai/mistral-small-2603
# AI_VISION_MODEL= # optional; defaults to AI_MODEL

# --- Auth.js (NextAuth v5) ---
# Random secret used to sign session/CSRF tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Authorized redirect URI must be:
#   <your-app-url>/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that are auto-promoted to super_admin on their
# very first sign-in (bootstraps who can approve everyone else).
SUPER_ADMIN_EMAILS=support@smoltrade.com
